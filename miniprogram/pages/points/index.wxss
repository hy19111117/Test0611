.tabs {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: #666666;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #ffffff;
  font-weight: 500;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.stat-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.stat-card.primary {
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #ffffff;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  margin-bottom: 8rpx;
  opacity: 0.8;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
}

.filter-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.filter-item {
  padding: 16rpx 28rpx;
  background: #ffffff;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #666666;
}

.filter-item.active {
  background: #FF6B6B;
  color: #ffffff;
}

.records-list {
  margin-top: 16rpx;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.record-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
}

.icon-add {
  background: rgba(39, 174, 96, 0.1);
}

.icon-deduct {
  background: rgba(231, 76, 60, 0.1);
}

.icon-exchange {
  background: rgba(155, 89, 182, 0.1);
}

.icon-task {
  background: rgba(52, 152, 219, 0.1);
}

.icon-default {
  background: rgba(153, 153, 153, 0.1);
}

.record-info {
  flex: 1;
}

.record-desc {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 4rpx;
}

.record-time {
  font-size: 24rpx;
  color: #999999;
}

.record-points {
  font-size: 32rpx;
  font-weight: 700;
}

.ranking-list {
  margin-top: 16rpx;
}

.ranking-item {
  display: flex;
  align-items: center;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.ranking-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  background: #F5F5F5;
  color: #999999;
  margin-right: 20rpx;
}

.ranking-badge.rank-1 {
  background: linear-gradient(135deg, #FFD700, #FFA500);
  color: #ffffff;
}

.ranking-badge.rank-2 {
  background: linear-gradient(135deg, #C0C0C0, #A8A8A8);
  color: #ffffff;
}

.ranking-badge.rank-3 {
  background: linear-gradient(135deg, #CD7F32, #B87333);
  color: #ffffff;
}

.ranking-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  margin-right: 20rpx;
}

.ranking-info {
  flex: 1;
}

.ranking-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 4rpx;
}

.ranking-role {
  font-size: 24rpx;
  color: #999999;
}

.ranking-points {
  text-align: right;
}

.ranking-points .points-num {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #FF6B6B;
}

.ranking-points .points-unit {
  font-size: 24rpx;
  color: #999999;
}

.task-stats-list {
  margin-top: 16rpx;
}

.task-stat-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #ffffff;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.task-stat-name {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.task-stat-count {
  font-size: 28rpx;
  font-weight: 600;
  color: #666666;
  margin-right: 24rpx;
}

.task-stat-points {
  font-size: 32rpx;
  font-weight: 700;
  color: #FF6B6B;
}
