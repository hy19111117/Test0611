<view class="container">
  <view class="add-btn" wx:if="{{isParent}}" bindtap="showAddModal">
    <text class="add-icon">+</text>
  </view>

  <view class="members-list">
    <view 
      class="member-card card" 
      wx:for="{{members}}" 
      wx:key="id"
      bindtap="goToDetail"
      data-id="{{item.id}}"
    >
      <view class="member-avatar" style="background: {{avatarColors[item.id % 5]}}">
        <text>{{item.name?.charAt(0)}}</text>
      </view>
      <view class="member-info">
        <view class="member-header">
          <text class="member-name">{{item.name}}</text>
          <text class="member-role" :class="item.role === 'parent' ? 'role-parent' : 'role-child'">
            {{item.role === 'parent' ? '家长' : '孩子'}}
          </text>
        </view>
        <view class="member-stats">
          <view class="stat-item">
            <text class="stat-value">{{item.points}}</text>
            <text class="stat-label">积分</text>
          </view>
          <view class="stat-divider"></view>
          <view class="stat-item">
            <text class="stat-value">{{getRecordCount(item.id)}}</text>
            <text class="stat-label">记录</text>
          </view>
        </view>
      </view>
      <view class="member-status">
        <view class="status-dot" :class="item.is_active ? 'active' : 'inactive'"></view>
      </view>
    </view>
  </view>

  <view wx:if="{{members.length === 0}}" class="empty-state">
    <text class="empty-icon">👨👩👧👦</text>
    <text class="empty-text">还没有家庭成员</text>
    <text class="empty-hint" wx:if="{{isParent}}">点击右上角添加成员</text>
  </view>

  <view class="modal-overlay" wx:if="{{showModal}}" bindtap="hideModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">{{editingMember ? '编辑成员' : '添加成员'}}</text>
        <text class="modal-close" bindtap="hideModal">×</text>
      </view>
      <view class="modal-body">
        <view class="form-item">
          <text class="form-label">姓名</text>
          <input 
            class="form-input" 
            placeholder="请输入姓名" 
            value="{{formData.name}}"
            bindinput="onNameInput"
          />
        </view>
        <view class="form-item">
          <text class="form-label">角色</text>
          <view class="role-options">
            <view 
              class="role-option" 
              :class="formData.role === 'parent' ? 'selected' : ''"
              bindtap="selectRole"
              data-role="parent"
            >
              <text>家长</text>
            </view>
            <view 
              class="role-option" 
              :class="formData.role === 'child' ? 'selected' : ''"
              bindtap="selectRole"
              data-role="child"
            >
              <text>孩子</text>
            </view>
          </view>
        </view>
        <view class="form-item">
          <text class="form-label">初始积分</text>
          <input 
            class="form-input" 
            type="number"
            placeholder="请输入初始积分" 
            value="{{formData.points}}"
            bindinput="onPointsInput"
          />
        </view>
      </view>
      <view class="modal-footer">
        <button class="btn-secondary" bindtap="hideModal">取消</button>
        <button class="btn-primary" bindtap="saveMember">保存</button>
      </view>
    </view>
  </view>
</view>