<view class="container">
  <view class="greeting-card card">
    <view class="greeting-content">
      <text class="greeting-title">Hi~ {{currentUser && currentUser.name || '宝贝'}}</text>
      <text class="greeting-subtitle">{{currentUser && currentUser.role === 'parent' ? '今天也要和孩子们一起加油哦！' : '今天也要努力赚积分呀！'}}</text>
    </view>
    <view class="avatar-wrapper">
      <view class="avatar" style="background: {{avatarColors[(currentUser && currentUser.id) % 5]}}">
          <text>{{(currentUser && currentUser.name) ? currentUser.name.charAt(0) : '?'}}</text>
      </view>
    </view>
  </view>

  <view class="points-card card">
    <view class="points-header">
      <text class="points-label">我的积分</text>
      <text class="points-value">{{currentUser && currentUser.points || 0}}</text>
    </view>
    <view class="points-trend">
      <view class="trend-item">
        <text class="trend-label">今日收入</text>
        <text class="trend-value text-success">+{{todayEarned}}</text>
      </view>
      <view class="trend-item">
        <text class="trend-label">今日支出</text>
        <text class="trend-value text-danger">-{{todaySpent}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-header">
      <text class="section-title">排行榜</text>
      <text class="section-more" bindtap="goToRanking">查看全部</text>
    </view>
    <view class="ranking-list">
      <view 
        class="ranking-item card" 
        wx:for="{{topMembers}}" 
        wx:key="id"
        bindtap="goToMemberDetail"
        data-id="{{item.id}}"
      >
        <view class="ranking-badge rank-{{index + 1}}">
          {{index + 1}}
        </view>
        <view class="ranking-avatar" style="background: {{avatarColors[item.id % 5]}}">
          <text>{{item.name.charAt(0)}}</text>
        </view>
        <view class="ranking-info">
          <text class="ranking-name">{{item.name}}</text>
          <text class="ranking-role">{{item.role === 'parent' ? '家长' : '孩子'}}</text>
        </view>
        <view class="ranking-points">
          <text class="points-num">{{item.points}}</text>
          <text class="points-unit">积分</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-header">
      <text class="section-title">待审核申请</text>
      <text class="section-more" bindtap="goToRequests">查看全部</text>
    </view>
    <view wx:if="{{pendingRequests.length === 0}}" class="empty-state">
      <text class="empty-text">暂无待审核申请</text>
    </view>
    <view wx:else>
      <view 
        class="request-item card" 
        wx:for="{{pendingRequests}}" 
        wx:key="id"
      >
        <view class="request-avatar" style="background: {{avatarColors[(item.family_members && item.family_members.id) % 5]}}">
          <text>{{(item.family_members && item.family_members.name) ? item.family_members.name.charAt(0) : '?'}}</text>
        </view>
        <view class="request-info">
          <text class="request-name">{{item.family_members && item.family_members.name || '未知'}}</text>
          <text class="request-task">申请: {{item.tasks && item.tasks.name || '未知任务'}}</text>
        </view>
        <view class="request-points text-{{item.points > 0 ? 'success' : 'danger'}}">
          {{item.points > 0 ? '+' : ''}}{{item.points}}
        </view>
      </view>
    </view>
  </view>

  <view class="quick-actions">
    <view class="action-btn" bindtap="goToTasks">
      <view class="action-icon" style="background: #FF6B6B;">
        <text class="icon-text">✓</text>
      </view>
      <text class="action-label">完成任务</text>
    </view>
    <view class="action-btn" bindtap="goToMall">
      <view class="action-icon" style="background: #4ECDC4;">
        <text class="icon-text">🎁</text>
      </view>
      <text class="action-label">积分商城</text>
    </view>
    <view class="action-btn" bindtap="goToRecords">
      <view class="action-icon" style="background: #45B7D1;">
        <text class="icon-text">📊</text>
      </view>
      <text class="action-label">积分明细</text>
    </view>
  </view>
</view>