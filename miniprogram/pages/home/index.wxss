.greeting-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  color: #ffffff;
}

.greeting-content {
  flex: 1;
}

.greeting-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.greeting-subtitle {
  display: block;
  font-size: 24rpx;
  opacity: 0.8;
}

.avatar-wrapper {
  margin-left: 20rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 600;
  color: #ffffff;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.points-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
}

.points-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.points-label {
  font-size: 28rpx;
  opacity: 0.8;
}

.points-value {
  font-size: 56rpx;
  font-weight: 700;
}

.points-trend {
  display: flex;
  justify-content: space-around;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  padding: 20rpx;
}

.trend-item {
  text-align: center;
}

.trend-label {
  display: block;
  font-size: 24rpx;
  opacity: 0.8;
  margin-bottom: 8rpx;
}

.trend-value {
  font-size: 32rpx;
  font-weight: 600;
}

.section {
  margin-top: 40rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 10rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.section-more {
  font-size: 26rpx;
  color: #FF6B6B;
}

.ranking-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.ranking-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
}

.ranking-badge {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 20rpx;
  background: #f5f5f5;
  color: #999;
}

.ranking-badge.rank-1 {
  background: linear-gradient(135deg, #FFD700, #FFA500);
  color: #ffffff;
}

.ranking-badge.rank-2 {
  background: linear-gradient(135deg, #C0C0C0, #A8A8A8);
  color: #ffffff;
}

.ranking-badge.rank-3 {
  background: linear-gradient(135deg, #CD7F32, #B87333);
  color: #ffffff;
}

.ranking-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  margin-right: 20rpx;
}

.ranking-info {
  flex: 1;
}

.ranking-name {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 4rpx;
}

.ranking-role {
  font-size: 22rpx;
  color: #999;
}

.ranking-points {
  text-align: right;
}

.points-num {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #FF6B6B;
}

.points-unit {
  font-size: 22rpx;
  color: #999;
}

.request-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.request-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  margin-right: 20rpx;
}

.request-info {
  flex: 1;
}

.request-name {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 4rpx;
}

.request-task {
  font-size: 24rpx;
  color: #999;
}

.request-points {
  font-size: 36rpx;
  font-weight: 600;
}

.empty-state {
  padding: 60rpx;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.quick-actions {
  display: flex;
  justify-content: space-around;
  padding: 40rpx 20rpx;
  margin-top: 40rpx;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 140rpx;
}

.action-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.icon-text {
  font-size: 40rpx;
}

.action-label {
  font-size: 26rpx;
  color: #666;
}