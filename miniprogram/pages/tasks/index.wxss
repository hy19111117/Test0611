.tabs {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: #666666;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #ffffff;
  font-weight: 500;
}

.tasks-list {
  margin-top: 24rpx;
}

.task-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
}

.task-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 24rpx;
}

.icon-add {
  background: rgba(39, 174, 96, 0.1);
}

.icon-deduct {
  background: rgba(231, 76, 60, 0.1);
}

.task-info {
  flex: 1;
}

.task-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.task-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.task-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.task-status.active {
  background: rgba(39, 174, 96, 0.1);
  color: #27AE60;
}

.task-status.inactive {
  background: rgba(153, 153, 153, 0.1);
  color: #999999;
}

.task-desc {
  font-size: 26rpx;
  color: #999999;
}

.task-action {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.task-points {
  font-size: 36rpx;
  font-weight: 700;
}

.action-buttons {
  display: flex;
  gap: 12rpx;
}

.action-btn {
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.action-btn.edit {
  background: rgba(52, 152, 219, 0.1);
  color: #3498DB;
}

.action-btn.submit {
  background: rgba(39, 174, 96, 0.1);
  color: #27AE60;
}

.type-options {
  display: flex;
  gap: 20rpx;
}

.type-option {
  flex: 1;
  padding: 20rpx;
  text-align: center;
  border: 2rpx solid #EEEEEE;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666666;
}

.type-option.selected {
  border-color: #FF6B6B;
  background: rgba(255, 107, 107, 0.1);
  color: #FF6B6B;
}

.request-task {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: #F9F9F9;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.request-task-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
}

.request-task-points {
  font-size: 32rpx;
  font-weight: 700;
}
